# KALEFLEH — configuration d'alerte email (facultative)
# Sans ces variables, aucune notification n'est envoyée (le site fonctionne normalement).

# Gmail : créer un "mot de passe d'application" dans le compte Google,
# puis :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=kalefleh.shop@gmail.com
# SMTP_PASS=XXXX XXXX XXXX XXXX

# Autre fournisseur (Exemple : Zoho, Ionos, Mailgun…)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Adresse qui reçoit les alertes "nouvelle demande" (par défaut kalefleh.shop@gmail.com)
# SMTP_TO=kalefleh.shop@gmail.com

# Mots de passe admin (séparés par des virgules) — défaut : ALJABIR,KADJA,ADMIN
# KALEFLEH_ADMINS=ALJABIR,KADJA,ADMIN
